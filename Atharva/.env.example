# Port the server listens on (Render/Railway/Heroku inject their own PORT automatically)
PORT=5001

# Comma-separated list of allowed origins, or * for all (dev only)
CORS_ORIGIN=*

# Seconds a bid within the final window triggers an anti-snipe extension
ANTI_SNIPE_WINDOW_SECONDS=15

# Seconds added to the clock when anti-snipe triggers
ANTI_SNIPE_EXTENSION_SECONDS=20

# Starting virtual wallet balance assigned to every new bidder (simulation only)
DEFAULT_WALLET_BALANCE=150000
